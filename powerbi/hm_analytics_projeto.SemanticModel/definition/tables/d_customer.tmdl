	column faixa_dias_de_compra =
			SWITCH(
				TRUE(),
				[purchase_days] = 1, "1 dia",
				[purchase_days] <= 3, "2 a 3 dias",
				[purchase_days] <= 5, "4 a 5 dias",
				[purchase_days] <= 10, "6 a 10 dias",
				"11 dias ou mais"
			)
		lineageTag: c8dbe135-04bd-41f1-8caa-148741b8410b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column perfil_recorrencia =
			
			IF(
			    d_customer[is_recurring_observed] = TRUE(),
			    "Recorrente",
			    "Compra única"
			)
		lineageTag: 68ce3edc-9125-4186-9faa-32051a8d629d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column perfil_canal_legenda =
			
			SWITCH(
			    d_customer[channel_profile],
			    "CHANNEL_2_ONLY", "Canal 2",
			    "CHANNEL_1_ONLY", "Canal 1",
			    "Multi Canais"
			)
		lineageTag: da20edd5-a3b9-4813-abde-1f987cba307a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

